---
import Base from '../layouts/Base.astro';
import PolicyDemo from '../components/PolicyDemo.vue';
import Flow from '../components/Flow.astro';
import Logo from '../components/Logo.astro';
import { getCollection } from 'astro:content';
import { person, facts, mandate, domains, work, principles, experience, projects } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// GitHub data at build time; a scheduled CI run keeps it fresh. Local text is the fallback.
const live = await Promise.all(projects.map(async (p) => {
  try {
    const r = await fetch(p.href.replace('https://github.com/', 'https://api.github.com/repos/'), {
      headers: process.env.GITHUB_TOKEN ? { authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {},
    });
    if (!r.ok) return p;
    const g = await r.json();
    return { ...p, name: g.name, href: g.html_url, text: g.description || p.text, updated: new Date(g.pushed_at) };
  } catch { return p; }
}));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={`${person.name}: cloud and AI platform architect`} description="Lead Platform Engineer in Berlin. Cloud, serverless, data, security and agentic AI, from idea to production.">
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="label">{person.role} · {person.city}</p>
        <h1>I architect the cloud that <em>AI products</em> run on</h1>
        <p class="lead">Cloud, data, security and agents, from first idea to production.</p>
        <div class="btns">
          <a class="btn btn--primary" href="#work">See my work</a>
          <a class="btn" href={`mailto:${person.email}`}>Get in touch</a>
        </div>
        <dl class="facts">
          {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        </dl>
      </div>
      <figure class="portrait">
        <img src="/thirumal.jpg" alt="Portrait of Thirumal Janakiraman" width="800" height="800" fetchpriority="high">
        <figcaption><strong>{person.name}</strong><span>{mandate.role} · {mandate.company}</span></figcaption>
      </figure>
    </div>
  </section>

  <section id="now">
    <div class="wrap">
      <div class="sec-head"><p class="label">01 · Now</p><h2>{mandate.role}, {mandate.company}</h2></div>
      <div class="mandate">
        <div><p class="mono muted">{mandate.since}</p><ul class="tags">{mandate.facts.map((f) => <li>{f}</li>)}</ul></div>
        <ol class="outcomes">{mandate.outcomes.map((o) => <li>{o}</li>)}</ol>
      </div>
    </div>
  </section>

  <section id="scope" class="band">
    <div class="wrap">
      <div class="sec-head"><p class="label">02 · Scope</p><h2>What I own, end to end</h2></div>
      <div class="domains">
        {domains.map((d) => (
          <div class="domain">
            <span class="logos">{d.icons.map((ic) => <Logo name={ic} />)}</span>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="sec-head"><p class="label">03 · Work</p><h2>Selected work</h2></div>
      {work.map((w) => (
        <article class="case" id={w.id}>
          <div>
            <p class="label">{w.tag}</p>
            <h3>{w.title}</h3>
            <p class="metric"><strong>{w.metric.value}</strong><span>{w.metric.label}</span></p>
            <dl class="tpl">
              <dt>Challenge</dt><dd>{w.challenge}</dd>
              <dt>What I did</dt><dd><ul class="ticks">{w.did.map((d) => <li>{d}</li>)}</ul></dd>
              <dt>Outcome</dt><dd>{w.outcome}</dd>
            </dl>
            <ul class="tags tags--sm">{w.facts.map((f) => <li>{f}</li>)}{w.link && <li class="tags__link"><a href={w.link.href}>{w.link.label} →</a></li>}</ul>
          </div>
          <div class="case__media">
            {w.image ? <img src={w.image.src} alt={w.image.alt} width="440" height="320" loading="lazy" /> : <Flow steps={w.flow ?? []} label={w.title} />}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="principles" class="band band--accent">
    <div class="wrap">
      <div class="sec-head"><p class="label">04 · Principles</p><h2>How I decide</h2></div>
      <ol class="principles">
        {principles.map((r) => <li><h3>{r.title}</h3><p>{r.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="sec-head"><p class="label">05 · Experience</p><h2>Since 2016</h2></div>
      <ol class="timeline">
        {experience.map((r) => (
          <li><span class="mono muted">{r.dates}</span><div><h3>{r.company}</h3><p>{r.role}</p></div><span class="muted">{r.place}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section id="open-source">
    <div class="wrap">
      <div class="sec-head"><p class="label">06 · Open source</p><h2>Tools I build</h2></div>
      <div class="oss">
        <PolicyDemo client:visible />
        <div class="cards">
          {live.map((p) => <a class="card" href={p.href}><h3>{p.name} ↗</h3><p>{p.text}</p>{'updated' in p && <p class="mono muted">Updated {fmt(p.updated)}</p>}</a>)}
        </div>
      </div>
    </div>
  </section>

  <section id="writing">
    <div class="wrap">
      <div class="sec-head"><p class="label">07 · Writing</p><h2>Latest posts</h2></div>
      <ul class="posts">
        {posts.map((p) => <li><a href={`/blog/${p.id}/`}><span class="mono muted">{fmt(p.data.date)}</span><div><h3>{p.data.title}</h3><p>{p.data.description}</p></div></a></li>)}
      </ul>
    </div>
  </section>

  <div class="wrap foot" id="contact">
    <h2>Have a hard cloud or AI problem?</h2>
    <div class="btns"><a class="btn btn--primary" href={`mailto:${person.email}`}>Write to me</a><a class="btn" href={person.linkedin}>LinkedIn</a><a class="btn" href={person.github}>GitHub</a></div>
  </div>
</Base>
